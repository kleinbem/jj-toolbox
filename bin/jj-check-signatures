#!/usr/bin/env bash
# jj-check-signatures — audit commits ahead of origin (on the trunk bookmark)
# for missing or unverified cryptographic signatures. Read-only; exits 1 if
# any unsigned commit is found, so it doubles as a pre-push gate. Runs
# against whatever jj repo you're cwd'd into.
set -euo pipefail

git fetch origin --prune --quiet 2>/dev/null || true
jj git import >/dev/null 2>&1 || true

trunk=$(jj log -r 'trunk()' --no-graph -T 'local_bookmarks.map(|b| b.name()).join("\n")' 2>/dev/null | head -1)
trunk="${trunk:-main}"
range="trunk()..${trunk}"

ahead=$(jj log -r "$range" --no-graph -T '"x\n"' 2>/dev/null | grep -c . || true)
if [ "$ahead" -eq 0 ]; then
    echo "No commits ahead of origin on $trunk — nothing to check."
    exit 0
fi

rows=$(jj log -r "$range" --no-graph -T '
  change_id.shortest(8) ++ "\t" ++
  if(signature,
    if(signature.status() == "good", "good", "unverified (" ++ signature.status() ++ ")"),
    "UNSIGNED"
  ) ++ "\t" ++
  description.first_line() ++ "\n"
')

{
    printf 'CHANGE\tSTATUS\tDESCRIPTION\n'
    printf '%s' "$rows"
} | column -t -s "$(printf '\t')"

if printf '%s' "$rows" | grep -q $'\tUNSIGNED\t'; then
    echo
    echo "UNSIGNED commits found ahead of origin — these will likely be rejected on push."
    exit 1
elif printf '%s' "$rows" | grep -q $'\tunverified'; then
    echo
    echo "Unverified != rejected — push will likely succeed; missing signer in allowed_signers is cosmetic."
fi
